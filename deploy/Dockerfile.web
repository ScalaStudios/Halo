FROM oven/bun:1.3.14-alpine AS deps
WORKDIR /web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

FROM node:22-alpine AS build
WORKDIR /web
ARG HALO_API_URL=http://halo-server:8080
ENV HALO_API_URL=$HALO_API_URL NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /web/node_modules ./node_modules
COPY web ./
RUN node_modules/.bin/next build

FROM node:22-alpine
WORKDIR /app
ARG HALO_API_URL=http://halo-server:8080
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3200 HALO_API_URL=$HALO_API_URL
COPY --from=build --chown=node:node /web/.next/standalone ./
COPY --from=build --chown=node:node /web/.next/static ./.next/static
COPY --from=build --chown=node:node /web/public ./public
USER node
EXPOSE 3200
CMD ["node", "server.js"]
